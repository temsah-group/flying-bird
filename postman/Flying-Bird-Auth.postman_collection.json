    {
      "name": "Admin",
      "item": [
        {
          "name": "1. Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "login"
              ]
            },
            "description": "Uses ADMIN_PASSWORD from the server .env. Put it in the collection variable adminPassword.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('adminToken', pm.response.json().token);",
                  "  console.log('admin token saved');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Games",
          "request": {
