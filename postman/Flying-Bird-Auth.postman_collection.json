                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "refresh"
              ]
            },
            "description": "Old token already used = stolen. Server ends the session.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gameId\": \"{{gameId}}\",\n  \"refreshToken\": \"{{oldRefreshToken}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.expect(pm.response.code).to.be.oneOf([401]));",
                  "pm.test('REFRESH_REUSED', () => pm.expect(pm.response.json().code).to.eql('REFRESH_REUSED'));"
                ]
              }
            }
          ]
        },
