{
  "info": {
    "name": "Flying Bird Auth",
    "description": "Streamer login (device-locked) + admin endpoints.\nSet adminPassword (and baseUrl for the live server) in the Variables tab, then Run the collection in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "login"
          ]
        },
        "description": "ADMIN_PASSWORD from the server .env (put it in the adminPassword variable).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Admin: create streamer account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "users"
          ]
        },
        "description": "Admin makes the account and gives username + password to the streamer. Saves userId.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gameId\": \"{{gameId}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"note\": \"Ahmed - Twitch\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
              "if (pm.response.code === 201) pm.collectionVariables.set('userId', pm.response.json().user.id);",
              "if (pm.response.code === 409) console.log('username exists: run \"Delete account\" first, or change the username variable');"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Streamer login (first time -> locks to this device)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "First successful login binds the account to deviceId. Returns ok + token.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gameId\": \"{{gameId}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
