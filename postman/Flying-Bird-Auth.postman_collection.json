            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('token', pm.response.json().token);",
              "  console.log('token saved');",
              "}"
            ]
          }
        }
      ]
    },
