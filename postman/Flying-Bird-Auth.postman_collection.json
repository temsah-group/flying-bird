            "url": {
              "raw": "{{baseUrl}}/admin/users?gameId={{gameId}}&status=all&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "gameId",
                  "value": "{{gameId}}"
                },
                {
                  "key": "status",
                  "value": "all"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "status = all | online | banned | alerts. Saves userId of {{username}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const j = pm.response.json();",
                  "const u = (j.users || []).find(x => x.username === pm.variables.get('username').toLowerCase()) || (j.users || [])[0];",
                  "if (u) { pm.collectionVariables.set('userId', u.id); console.log('userId saved:', u.username, u.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "4b. Security alerts",
