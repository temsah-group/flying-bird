PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=flying-bird

# Games allowed to use this server (comma separated).
# New game later: add its id here, and use the same id in the game client.
GAMES=flying-bird

# Secret used to sign access tokens. Long random string, NEVER share it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access token lifetime (minutes) and refresh token lifetime (days)
ACCESS_TOKEN_MIN=15
REFRESH_TOKEN_DAYS=30

# Game sends a heartbeat every HEARTBEAT_SEC.
# If no heartbeat for SESSION_TIMEOUT_SEC (game crashed / no internet),
# the account can be used from another device.
HEARTBEAT_SEC=30
SESSION_TIMEOUT_SEC=120

# ===== Admin dashboard =====
# Password to log in to the admin dashboard (10+ chars). Empty = dashboard disabled.
ADMIN_PASSWORD=
# How long the admin stays logged in (hours)
ADMIN_TOKEN_HOURS=12
# Websites allowed to call the API from a browser (the dashboard). * = any
# Example: http://localhost:5173,https://admin.mygame.com
CORS_ORIGINS=*

# ===== Brute-force protection (player login) =====
# Wrong passwords allowed (same IP + same username) before locking
LOGIN_MAX_ATTEMPTS=5
# Lock time in minutes
LOGIN_LOCK_MIN=15
