PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=flying-bird

# Games allowed to use this server (comma separated)
GAMES=flying-bird

# Secret used to sign tokens. Long random string, NEVER share it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token returned by /login: valid for how many hours
TOKEN_HOURS=24

# Brute-force protection: wrong passwords (same IP + same username) before locking, and lock minutes
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MIN=15

# Keep login history for how many days
LOGIN_LOG_DAYS=30

# ===== Admin dashboard =====
# Password to log in to the admin dashboard (10+ chars). Empty = dashboard disabled.
ADMIN_PASSWORD=
ADMIN_TOKEN_HOURS=12
# Websites allowed to call the API from a browser (the dashboard). * = any
CORS_ORIGINS=*
